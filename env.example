# Configuración del servidor
PORT=3001
NODE_ENV=development

# Configuración de email
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-contraseña-de-aplicación
EMAIL_TO=destinatario@ejemplo.com

# OpenAI API Key (requerida para el widget "Pregúntale a esta página")
OPENAI_API_KEY=sk-tu-api-key-de-openai-aqui

# URL pública del backend usada por el frontend en producción
VITE_API_BASE_URL=https://gyotechnologiesweb.onrender.com

# Opcional: generar sourcemaps en builds de frontend
VITE_BUILD_SOURCEMAP=false
